---
import Base from "../../layouts/Base.astro";
import ResearchCards from "../../components/ResearchCards.astro";
import publications from "../../data/publications.json";
---

<Base
  title="Research"
  description="Explore ARMS research in Cognitive Manufacturing and machining/DED hybrid manufacturing."
  current="/research/"
>
  <section class="section detail-intro research-intro">
    <p class="eyebrow">Research at ARMS</p>
    <h1>
      From software
      <br />
      to the manufactured part.
    </h1>
    <p class="lead">
      We investigate Cognitive Manufacturing and machining/DED hybrid processes,
      connecting engineering knowledge, software systems, and experiments to
      rethink manufacturing workflows and advance manufacturing processes.
    </p>
    <p>
      Cognitive Manufacturing explores engineering information that people can
      understand and computers can use, with the aim of accelerating work from
      design to production. Semantic Manufacturing and Agentic Manufacturing
      provide two complementary paths toward this vision.
    </p>
  </section>
  <section class="section research-section">
    <ResearchCards />
  </section>
  <section class="section reading-link">
    <span class="role">Publications</span>
    <a href="/publications/">
      Browse all {publications.length} ARMS publications →
    </a>
  </section>
</Base>
