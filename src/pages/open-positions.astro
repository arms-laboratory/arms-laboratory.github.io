---
import Base from "../layouts/Base.astro";
---

<Base
  title="Student research"
  description="Graduate and undergraduate research at ARMS, and how to send a student inquiry."
  current="/open-positions/"
>
  <section class="section student-intro" id="join">
    <p class="eyebrow">Student research at ARMS</p>
    <h1>
      Bring your curiosity
      <br />
      to manufacturing research.
    </h1>
    <p>
      Graduate students form the core of research at ARMS, advancing our work in
      manufacturing systems and processes through experimental research.
    </p>
    <p>
      Undergraduates contribute alongside graduate researchers, gaining hands-on
      experience in CNC machining and machine tools beyond regular manufacturing
      courses at UC Davis. Some continue into graduate study, building on this
      experience to get a head start on their graduate research.
    </p>
    <p>
      We welcome inquiries from undergraduate, master’s, and PhD students. Tell
      us about your background and research interests.
    </p>
    <a
      class="button primary"
      href="https://docs.google.com/forms/d/e/1FAIpQLSfzkuls8SktTR6h8LjhqNDLTKo2afUI3-cOIgn7XEoejJseMg/viewform"
    >
      Send a student inquiry ↗
    </a>
    <small>Opens Google Forms</small>
  </section>
  <section class="section student-paths">
    <p class="eyebrow">Explore ARMS</p>
    <div class="two-links">
      <article>
        <h2>Find your research direction.</h2>
        <p>
          Explore our work in software agents and machining/DED hybrid
          manufacturing.
        </p>
        <a href="/research/">Explore research →</a>
      </article>
      <article>
        <h2>Get to know the laboratory.</h2>
        <p>
          Meet the researchers and learn about our approach to experimental
          manufacturing research.
        </p>
        <a href="/members/">Meet our people →</a>
      </article>
    </div>
  </section>
</Base>
