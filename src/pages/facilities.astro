  description="CNC machining, directed energy deposition, and measurement support ARMS research."
>
  <section class="section split capabilities">
    <div>
      <p class="eyebrow">Experimental capabilities</p>
      <h1>Research grounded in making and measuring.</h1>
      <p>
        ARMS uses CNC machining, directed energy deposition, and measurement to
        investigate manufacturing processes and equipment.
      </p>
      <a href="/research/">Explore research →</a>
    </div>
    <figure>
      <img
        src="/images/cmm.webp"
        width="1800"
        height="1350"
        alt="Coordinate measuring machine measuring a manufactured sample"
      />
      <figcaption>
        Coordinate measurement supports experimental evaluation.
      </figcaption>
    </figure>
  </section>
</Base>
