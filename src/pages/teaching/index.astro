---
import Base from "../../layouts/Base.astro";
---

<Base
  title="Teaching"
  description="Course materials and interactive mechatronics simulators from the ARMS Laboratory at UC Davis."
  current="/teaching/"
>
  <section class="section detail-intro">
    <p class="eyebrow">Learning engineering</p>
    <h1>Teaching</h1>
    <p class="lead">
      Explore course materials and interactive tools for learning engineering.
      Change a setting, follow what happens, and connect the result to the ideas
      behind it.
    </p>
  </section>
  <section class="section" aria-labelledby="course-materials">
    <h2 id="course-materials">Course materials</h2>
    <div class="two-links">
      <article>
        <p class="eyebrow">EME154</p>
        <h3>Mechatronics</h3>
        <p>
          Explore microcontrollers, timing, motion measurement, feedback
          control, and motor drives through nine interactive labs and two
          companion calculators. The tools run in your browser.
        </p>
        <a class="text-link" href="/teaching/mechatronics/simulators.html">
          Explore the mechatronics simulators
        </a>
      </article>
    </div>
  </section>
</Base>
