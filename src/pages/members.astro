---
import Base from "../layouts/Base.astro";
---

<Base
  title="People"
  description="Meet the researchers of the ARMS Laboratory at UC Davis."
  current="/members/"
>
  <section class="section people-page" id="people">
    <p class="eyebrow">People</p>
    <h1>Meet the researchers.</h1>
    <div class="people-grid">
      <article>
        <p class="role">Professor · Principal Investigator</p>
        <h3>Masakazu Soshi</h3>
        <p>Director of the ARMS Laboratory at UC Davis.</p>
        <p>
          <a href="https://faculty.engineering.ucdavis.edu/soshi/">
            Faculty profile ↗
          </a>
        </p>
        <a href="mailto:msoshi@ucdavis.edu">Contact Professor Soshi →</a>
      </article>
      <article>
        <p class="role">Master’s student</p>
        <h3>Charles Ringham</h3>
        <p>
          Research interests include CNC machining, computer-aided design, and
          additive manufacturing.
        </p>
        <p class="note">BS, UC Davis, 2022</p>
      </article>
      <article>
        <p class="role">PhD student</p>
        <h3>Ryan Daugherty</h3>
        <p>
          Research interests include Agentic Manufacturing and additive
          manufacturing.
        </p>
        <p class="note">BS, UC Davis, 2026</p>
      </article>
      <article>
        <p class="role">MS student</p>
        <h3>Advay Prasad</h3>
        <p>
          Research interests include machining/DED hybrid manufacturing and CNC
          machining.
        </p>
        <p class="note">BS, UC Davis, 2026</p>
      </article>
    </div>
  </section>
  <section class="section soft alumni-introduction">
    <div>
      <p class="eyebrow">The ARMS community</p>
      <h2>Our alumni.</h2>
    </div>
    <div>
      <p>
        ARMS alumni contribute to research, education, and industry around the
        world. Their work carries forward the laboratory’s spirit of inquiry and
        advances manufacturing through new ideas, technologies, and
        collaboration.
      </p>
      <a class="text-link" href="/members/alumni/">
        Meet our alumni →
      </a>
    </div>
  </section>
</Base>
