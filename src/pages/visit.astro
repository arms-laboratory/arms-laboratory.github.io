---
import Base from "../layouts/Base.astro";
---

<Base
  title="Contact & Visit"
  description="Visit the ARMS Laboratory at Bainer Hall, UC Davis. Find Lot 47, the east entrance, and office 2020C."
  current="/visit/"
>
  <section class="section detail-intro visit-intro">
    <p class="eyebrow">Contact &amp; Visit</p>
    <h1>
      Find your way
      <br />
      to ARMS.
    </h1>
    <p>
      Bainer Hall · University of California, Davis
      <br />
      One Shields Avenue, Davis, CA 95616
    </p>
    <p>
      If you are meeting Professor Soshi, come to his office in{" "}
      <strong>2020C Bainer Hall</strong>.
    </p>
    <div class="actions">
      <a
        class="button primary"
        href="https://www.google.com/maps/d/viewer?mid=1AqNmU8UxnDRbIRWsVk0oERyoj8M"
      >
        Open ARMS visitor map ↗
      </a>
      <a class="button secondary" href="mailto:msoshi@ucdavis.edu">
        Coordinate your visit
      </a>
    </div>
  </section>
  <section class="section soft" id="visitor-map">
    <p class="eyebrow">Map &amp; arrival</p>
    <h2>Plan your arrival at Bainer Hall.</h2>
    <div class="split visit-arrival">
      <div>
        <h3>Visitor Parking Lot 47</h3>
        <p>
          Lot 47 is the recommended visitor parking location for Bainer Hall.
          Check the current parking rules and payment options before you travel.
        </p>
        <a href="https://taps.ucdavis.edu/">
          Current parking information &amp; payment ↗
        </a>
      </div>
      <div>
        <h3>East-side main entrance</h3>
        <p>
          From Lot 47, use the main entrance on the east side of Bainer Hall.
          Look for the “ROY BAINER HALL” lettering above the doors.
        </p>
      </div>
    </div>
    <div class="actions">
      <a
        class="button secondary"
        href="https://www.google.com/maps/d/viewer?mid=1AqNmU8UxnDRbIRWsVk0oERyoj8M"
      >
        View the ARMS parking and access map ↗
      </a>
      <a href="https://campusmap.ucdavis.edu/">UC Davis campus map ↗</a>
    </div>
  </section>
  <section class="section" id="rooms">
    <p class="eyebrow">Rooms in Bainer Hall</p>
    <h2>Know where you are going.</h2>
    <div class="three visit-rooms">
      <div>
        <p class="role">Meeting Professor Soshi</p>
        <h3>2020C</h3>
        <p>Professor Soshi’s office</p>
      </div>
      <div>
        <p class="role">Students</p>
        <h3>1125A</h3>
        <p>Student office</p>
      </div>
      <div>
        <p class="role">Research facilities</p>
        <h3>1229</h3>
        <p>Machining laboratory</p>
      </div>
    </div>
    <p>
      For assistance finding your meeting location, contact Professor Soshi at{" "}
      <a href="tel:+15307528073">(530) 752-8073</a> or{" "}
      <a href="mailto:msoshi@ucdavis.edu">msoshi@ucdavis.edu</a>.
    </p>
  </section>
</Base>
